{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://matchset-backend.onrender.com/api/:path*"
    },
    {
      "source": "/set/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/community/:slug",
      "destination": "/index.html"
    }
  ]
}
